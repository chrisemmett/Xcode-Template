# SwiftFormat configuration. `make format` applies it; `make lint` checks it.
--swiftversion 6.0
--exclude **/.build,**/DerivedData,build,fastlane,vendor,.claude
--indent 4
--maxwidth 140
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--ifdef indent
--self remove
--stripunusedargs closure-only
--header ignore
--disable redundantReturn,wrapMultilineStatementBraces
