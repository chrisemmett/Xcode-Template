{
  "_comment": "Project-level permission allowlist: the commands the release-to-testflight skill and day-to-day checks run, so they don't fire a permission prompt at every step. Read-only or repo-local commands only; nothing here can push to a protected branch (the ruleset refuses that anyway). Merge with any existing settings.json rather than overwriting.",
  "permissions": {
    "allow": [
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin testflight-:*)",
      "Bash(git tag -a testflight-:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch --show-current)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(xcodegen:*)",
      "Bash(make help)",
      "Bash(make check)",
      "Bash(make test-core)",
      "Bash(make test-scripts)",
      "Bash(make generate)",
      "Bash(swift test:*)",
      "Bash(python3 -B scripts/check_store_metadata.py:*)",
      "Bash(scripts/check_lld_todo_done.sh)"
    ]
  }
}
